# Rootfs system service list.
# Intended location in rootfs: /nanami/system-list
# Format: <name> <priority> <path> [argv...]
#
# System Manager reads this after vfs-service is online.
terminal-service 21 /bin/terminal-service
posix-service 21 /bin/posix-server
alter-linux 21 /bin/alter-linux
negoto-service 20 /bin/negoto serve
alter-freebsd 21 /bin/alter-freebsd
input-service 28 /bin/input-server
honoka-service 24 /bin/honoka
network-service 22 /bin/net-server
